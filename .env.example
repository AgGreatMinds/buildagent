# Modelo de configuração do BuildAgent. Copie para `.env` (que fica fora do git) ou exporte no terminal.
# Nenhuma variável é obrigatória; os valores abaixo são os padrões.

# Porta e endereço de escuta. ATENÇÃO: qualquer HOST fora de 127.0.0.1 expõe o painel na rede local, sem senha.
HABBLAUD_PORT=4750
HABBLAUD_HOST=127.0.0.1

# Nomes extras aceitos no endereço (vírgula). Só é preciso se você abrir o painel por um nome que não seja
# localhost nem um IP; sem isso o servidor responde 421.
# HABBLAUD_ALLOWED_HOSTS=meu-computador.local

# Única pasta em que o BuildAgent escreve (estatísticas do dia e linha do tempo do replay).
# HABBLAUD_DATA_DIR=~/.habblaud

# 1 = agentes fictícios, nenhuma sessão real é lida (igual a `npm run demo`).
# HABBLAUD_DEMO=1

# Fontes: 0 desliga. Os caminhos só precisam ser informados se não forem os padrões.
# HABBLAUD_CLAUDE_DIRS=~/.claude,~/.claude-trabalho
# HABBLAUD_CODEX_DIRS=~/.codex
# HABBLAUD_OPENCODE_DB=/caminho/para/opencode.db
# HABBLAUD_CODEX=0
# HABBLAUD_OPENCODE=0
# HABBLAUD_PI=0
# HABBLAUD_PI_DIR=~/.pi/agent/sessions
# HABBLAUD_OPENBOT=0
# HABBLAUD_OPENBOT_DB=/caminho/para/openbot.db

# 0 = não grava a linha do tempo usada no replay.
# HABBLAUD_TIMELINE=0

# en = textos do servidor em inglês (padrão: português).
# HABBLAUD_LANG=en
